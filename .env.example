# Copia este archivo a .env.local y llena los valores desde tu proyecto de Supabase
# (Project Settings -> API). Nunca commitees .env.local.

# URL del proyecto de Supabase. Pública, va en el bundle del navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Anon/public key. Pública, va en el bundle del navegador. La seguridad real
# la da RLS en Postgres, no el secreto de esta key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service role key: IGNORA Row Level Security. SOLO para uso en servidor
# (src/lib/supabase/admin.ts), en operaciones de sistema/plataforma. NUNCA
# debe tener el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
